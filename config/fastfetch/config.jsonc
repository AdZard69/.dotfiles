{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "type": "command-raw",
    "source": "pokemon-colorscripts --random --no-title",
    "padding": {
      "top": 0,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 10,
      "paddingLeft": 0
    },
    "color": {
      "separator": "#3b424a",
      "output": "#c7ccd1"
    }
  },

  "modules": [
    {
      "type": "custom",
      "format": "    TRAINER TERMINAL",
      "outputColor": "#e0ad55"
    },

    {
      "type": "title",
      "key": "  ",
      "keyColor": "#56d6e0",
      "color": {
        "user": "#c7ccd1",
        "at": "#59636b",
        "host": "#7aa2f7"
      }
    },

    {
      "type": "os",
      "key": "   OS",
      "keyColor": "#56d6e0"
    },

    {
      "type": "kernel",
      "key": "   Kernel",
      "keyColor": "#56d6e0"
    },

    {
      "type": "cpu",
      "key": "   CPU",
      "keyColor": "#e0ad55",
      "format": "{name}"
    },

    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "#e0ad55",
      "format": "{used} / {total}"
    },

    {
      "type": "uptime",
      "key": "  󰔚 Uptime",
      "keyColor": "#56d6e0"
    },

    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "#7aa2f7"
    },

    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "#7aa2f7"
    }
  ]
}
