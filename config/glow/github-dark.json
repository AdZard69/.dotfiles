{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#c9d1d9",
    "margin": 1
  },
  "block_quote": {
    "color": "#8b949e",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "color": "#c9d1d9",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#58a6ff",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#0d1117",
    "background_color": "#58a6ff",
    "bold": true
  },
  "h2": { "prefix": "▌ ", "color": "#58a6ff", "bold": true },
  "h3": { "prefix": "▏ ", "color": "#3fb950", "bold": true },
  "h4": { "prefix": "  ", "color": "#bc8cff", "bold": true },
  "h5": { "prefix": "  ", "color": "#39c5cf", "bold": true },
  "h6": { "prefix": "  ", "color": "#d2a8ff", "bold": true },
  "text": { "color": "#c9d1d9" },
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "#e3b341", "italic": true },
  "strong": { "color": "#ff7b72", "bold": true },
  "hr": {
    "color": "#30363d",
    "format": "\n────────────────────────────────────────────────────\n"
  },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "☑ ", "unticked": "☐ " },
  "link": { "color": "#58a6ff", "underline": true },
  "link_text": { "color": "#58a6ff", "bold": true },
  "image": { "color": "#58a6ff", "underline": true },
  "image_text": { "color": "#c9d1d9", "format": "Image: {{.text}} →" },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#ff7b72",
    "background_color": "#161b22"
  },
  "code_block": {
    "color": "#c9d1d9",
    "margin": 1,
    "theme": "github-dark"
  },
  "table": {
    "color": "#c9d1d9",
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": { "color": "#58a6ff", "bold": true },
  "definition_description": { "block_prefix": "\n  ⭑ " },
  "html_block": {},
  "html_span": {}
}
